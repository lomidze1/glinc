# Contact form email (Resend). Copy to .env.local and fill in.
# Without these, the contact form returns a clear "not live yet" message
# instead of pretending a message was sent.

RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@glinc.io   # must be a Resend-verified sender
CONTACT_TO_EMAIL=hello@glinc.io     # where messages are delivered (optional)
